NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://inventory:inventory@localhost:15432/inventory
# Optional direct Neon URL for migrations when DATABASE_URL is pooled.
# MIGRATION_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/db?sslmode=require
# Neon CLI writes its direct URL using this name; migrations use it automatically.
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/db?sslmode=require
DATABASE_SSL=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=inventory-backend
KAFKA_GROUP_ID=inventory-consumer
KAFKA_TOPIC=inventory-events
KAFKA_TOPIC_PARTITIONS=3
KAFKA_SSL=false
# Managed Kafka: set TLS, the provider's SASL mechanism, and both credentials.
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Optional base64-encoded PEM CA for providers such as Aiven using a project CA.
KAFKA_CA_CERT_BASE64=
# For Aiven client-certificate authentication, base64 encode service.cert and service.key.
KAFKA_CLIENT_CERT_BASE64=
KAFKA_CLIENT_KEY_BASE64=
CORS_ORIGINS=http://localhost:5173
ADMIN_USERNAME=admin
# Generate with npm run auth:hash -- "a-long-random-password"
ADMIN_PASSWORD_HASH=
# Generate at least 32 random characters and keep private.
JWT_SECRET=
TRUST_PROXY=false
LOG_LEVEL=info
